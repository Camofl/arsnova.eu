---
import { appHomeUrl, GITHUB_URL } from '@/config/github';
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;
const c = t.compass;
const docsUrl = `${GITHUB_URL}/blob/main/docs/features/moderation-compass.md`;
---

<section
  id="moderation-compass"
  class="relative px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="compass-heading"
>
  <span id="moderationskompass" class="absolute top-0 left-0 h-0 w-0 overflow-hidden" aria-hidden="true"></span>
  <div class="mx-auto grid min-w-0 max-w-6xl gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
    <div class="min-w-0">
      <p class="landing-eyebrow">{c.eyebrow}</p>
      <h2 id="compass-heading" class="mt-3 break-words font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl">
        {c.title}
      </h2>
      <p class="mt-5 break-words text-lg leading-8 text-landing-fg-muted">{c.lead}</p>
      <ul class="mt-8 grid min-w-0 gap-3 text-sm leading-6 text-landing-fg-body sm:grid-cols-2" role="list">
        {c.summary.map((item) => (
          <li class="min-w-0 rounded-landing-panel border border-landing-outline-variant bg-landing-surface-container p-4">
            <span class="font-semibold text-landing-fg">{item}</span>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={appHomeUrl(locale)} class="landing-btn-primary">
          {c.tryLink}
        </a>
        <a
          href={docsUrl}
          class="inline-flex rounded-landing-button border border-landing-outline bg-landing-surface-container px-5 py-3 text-sm font-semibold text-landing-fg transition duration-landing-fast hover:border-landing-primary hover:bg-landing-surface-container-high focus:outline-none focus-visible:ring-2 focus-visible:ring-landing-focus focus-visible:ring-offset-4 focus-visible:ring-offset-landing-bg"
          target="_blank"
          rel="noopener noreferrer"
        >
          {c.docsLink}
        </a>
      </div>
    </div>

    <div
      class="landing-panel min-w-0 rounded-landing-card p-4 shadow-landing-2 sm:p-5"
      role="region"
      aria-label={c.demoAria}
    >
      <div class="flex min-w-0 flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="break-words text-xs font-semibold uppercase tracking-[0.12em] text-landing-status-violet sm:tracking-[0.18em]">{c.hostView}</p>
          <h3 class="mt-1 break-words font-display text-2xl font-bold text-landing-fg">{c.demoTitle}</h3>
        </div>
        <span class="inline-flex shrink-0 items-center gap-1.5 rounded-landing-panel border border-landing-status-violet/40 bg-landing-status-violet-bg px-3 py-1 text-sm font-semibold text-landing-status-violet" aria-hidden="true">
          <span>🧭</span>
          {c.nextLabel}
        </span>
      </div>

      <div class="mt-5 rounded-landing-card border border-landing-primary/40 bg-landing-primary-container p-4">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-landing-on-primary-container">{c.nextLabel}</p>
        <p class="mt-2 font-display text-lg font-semibold text-landing-on-primary-container">{c.nextTitle}</p>
        <p class="mt-2 text-sm leading-6 text-landing-on-primary-container/90">{c.nextText}</p>
      </div>

      <div class="mt-4 grid min-w-0 gap-3">
        {c.cards.map((card) => (
          <article
            class:list={[
              'min-w-0 rounded-landing-panel border p-4',
              card.tone === 'rose' && 'border-landing-status-rose/40 bg-landing-status-rose-bg',
              card.tone === 'amber' && 'border-landing-status-amber/40 bg-landing-status-amber-bg',
              card.tone === 'violet' && 'border-landing-status-violet/40 bg-landing-status-violet-bg',
            ]}
          >
            <h4
              class:list={[
                'break-words text-sm font-semibold',
                card.tone === 'rose' && 'text-landing-status-rose',
                card.tone === 'amber' && 'text-landing-status-amber',
                card.tone === 'violet' && 'text-landing-status-violet',
              ]}
            >
              {card.label}
            </h4>
            <p
              class:list={[
                'mt-1 break-words text-sm leading-6',
                card.tone === 'rose' && 'text-landing-status-rose/90',
                card.tone === 'amber' && 'text-landing-status-amber/90',
                card.tone === 'violet' && 'text-landing-status-violet/90',
              ]}
            >
              {card.text}
            </p>
          </article>
        ))}
      </div>

      <div class="mt-5">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-landing-fg-muted">{c.sourcesLabel}</p>
        <div class="mt-2 flex min-w-0 flex-wrap gap-2">
          {c.sources.map((source) => (
            <span class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface px-3 py-1.5 text-xs font-semibold text-landing-fg">
              {source}
            </span>
          ))}
        </div>
      </div>
      <p class="mt-4 break-words text-sm leading-6 text-landing-fg-muted">{c.note}</p>
    </div>
  </div>
</section>
